  "@queueCauseParseFailed": {
    "description": "B22 for `parse_failed`: the app's own failure, named as its own. `C5` says a failure the reader cannot report is a failure nobody will fix."
  },
  "@queueCauseRateLimited": {
    "description": "B24 for `rate_limited`. `17-security.md` rule 6: the answer is to wait, never to hammer — and the sentence must not sound like the site is broken."
  },
  "@queueCauseSourceEmpty": {
    "description": "E8/B22 for `source_empty`. The distinction from 'the app has nothing' is the whole point: the SITE said so itself."
  },
  "@queueCauseSourceLayoutChanged": {
    "description": "B22 for `source_layout_changed`, E4. 'this app cannot read this site any more' is a report the owner can act on; 'download failed' is not."
  },
  "@queueCauseSourceUnavailable": {
    "description": "B3 for `source_unavailable`: the novel names a site this build no longer contains, which is a statement about the app rather than about the chapter."
  },
  "@queueCauseStorageFull": {
    "description": "E20 for `storage_full`. NEVER a free-space figure — `downloads.md` § 9 — and never 'try again', which would send the reader round the same loop."
  },
  "@queueCauseUnknown": {
    "description": "The only honest sentence for an unreadable code. `queue_run_state_deriver.dart` maps one to `QueueStopReason.unknown` and this is what the reader is shown — it does not guess, and C12 accepts a true 'the app cannot say' over a plausible fiction."
  },
