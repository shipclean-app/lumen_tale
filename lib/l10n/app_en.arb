  "browseSourceUnavailableBody": "The page loaded, but the part that lists novels was not on it. Nothing is wrong with your library, and nothing was downloaded.",
  "@browseSourceUnavailableBody": {
    "description": "⚠️ **Two sentences a reader needs and cannot guess.** `Nothing is wrong with your library` comes first because the failure looks like a bug in the app, and `nothing was downloaded` because the fear is that a check ate their downloads. This is SC-6's only surface."
  },
  "browseEmptyTagTitle": "Nothing tagged {tag}",
  "@browseEmptyTagTitle": {
    "description": "⚠️ **The tag is echoed back**, because a reader who has forgotten what they tapped needs to be told — and an empty-state sentence that does not name the tag could belong to any screen."
  },
  "browseEmptyTagBody": "{source} publishes no novel under that tag. Try another tag.",
