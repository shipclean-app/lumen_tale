    "placeholders": {
      "count": {
        "type": "String",
        "example": "96"
      }
    }
  },
  "@settingsDialogClearHistoryBody": {
    "description": "B46, and the second clause is the whole sentence: reading positions are not in this list. `clearAll()` deletes exactly one table and a row asserts the positions survive."
  },
  "@settingsDialogClearHistoryConfirm": {
    "description": "⚠️ **`Clear`, not `OK`, and not `Delete`** — it names the object. And § 4 (Empty — no data) forbids the dialog opening at all when the count is zero, so a reader is never asked to confirm destroying nothing."
  },
  "@settingsSnackHistoryCleared": {
    "description": "The second clause is **mandatory and is the entire success message**, because B46 makes position the thing the reader must believe survived. A generic 'History cleared' leaves the reader fearing they lost their place, which is the app's core promise (B16)."
  },
  "@settingsRowLanguageLabel": {
    "description": "**Read-only, and visibly so**: no chevron, no ripple, no pressed state. B28 forbids an in-app language picker — the platform owns this value and a second source of truth for it is a bug waiting to happen."
  },
  "@settingsRowLanguageHint": {
    "description": "Tells the reader where the control actually is, because there isn't one here. A read-only row with no explanation reads as a disabled control."
  },
  "@settingsRowOnboardingLabel": {
    "description": ""
  },
  "@settingsRowOnboardingValue": {
    "description": ""
  },
  "@settingsRowAboutLabel": {
    "description": ""
  },
  "@settingsRowAboutValue": {
    "description": "The same `{buildName}` · build `{buildNumber}` pair `3-5` shows, from the same `AppRoutes`-level source. Two spellings of the version on two pages would be two truths about which build is installed (C9).",
    "placeholders": {
      "buildName": {
        "type": "String",
        "example": "0.9.0"
      },
      "buildNumber": {
        "type": "String",
        "example": "41"
      }
    }
  },
  "@settingsDisclosureE11": {
    "description": ""
  },
  "@settingsDisclosureE11Footer": {
    "description": "The footer, and it exists because of what it admits: the app cannot detect an uninstall as it happens, so the disclosure has to happen **before** rather than after. A disclosure that says 'you cannot undo this' without saying why is read as an apology."
  },
  "@settingsDisclosureAboutLink": {
    "description": "The ghost link into About, and its label is the QUESTION it answers (B31's guarantee). A link labelled 'About' would compete with the row above it."
  },
  "@settingsErrorWrite": {
    "description": "A failed write, shown **beside** the control and never by tinting it — a red control reads as 'this setting is now off' rather than 'this setting could not be saved'."
  },
  "@settingsErrorCountUnavailable": {
    "description": "A count that could not be obtained, and **never `0`** (B48). § 4 (Load error, declined) scopes the failure to the one row that owns it: a failed `COUNT` renders this word on its own line and disables the clear row, rather than blanking eight correct rows."
  },
  "@settingsButtonRetry": {
    "description": ""
  },
  "@settingsButtonCancel": {
    "description": ""
  },
  "@settingsTitle": {
    "description": ""
  },
  "@settingsLanguageEnglish": {
    "description": "⚠️ **Identical in the French file.** The `Language` row reports the phone's language, not the app's, and a reader on an English UI with a French phone must see \"Français\". B28: the app follows the phone."
  },
  "@settingsLanguageFrench": {
    "description": "⚠️ **Identical in the English file**, for the same reason. A value that changes with the ARB would be the app naming the phone's language in the app's language, which is a different claim."
  },
  "readerOfflineBanner": "You are reading your downloads",
  "@readerOfflineBanner": {
    "description": "⚠️ **One ephemeral line, on the FIRST offline display of a session only.** § 3.5 forbids a banner, a gradient and any 'OFFLINE MODE' — this is a sentence that appears once and does not persist, because a persistent badge would be the third thing competing with the prose for the reader's attention."
  },
  "readerNotStoredTitle": "This chapter is not downloaded",
  "@readerNotStoredTitle": {
    "description": "⚠️ **Empty-data, NOT an empty screen.** US-05: the reader must be able to SEE that 'not downloaded' differs from 'empty' and from 'failed'."
  },
  "readerNotStoredBody": "Only chapters already on this phone can be read here.",
  "@readerNotStoredBody": {
    "description": "The constraint this screen enforces: the reader never fetches. § 3.1's 'ChapterNotStored' branch emits an intent and 3-3 executes it."
  },
  "readerOfflineAbsentTitle": "This chapter is not downloaded and there is no connection",
  "@readerOfflineAbsentTitle": {
    "description": "⚠️ **BOTH facts in one sentence, and each is on its own insufficient.** 'Not downloaded' leaves the reader wondering whether the button will work; 'offline' leaves them wondering whether the chapter is theirs. B24 asks for the sentence that names both."
  },
  "readerOfflineAbsentBody": "Both are needed: the chapter has to be downloaded once, and downloading needs a connection.",
  "readerFileMissingTitle": "This chapter had been downloaded, but its text is no longer on this phone",
  "readerFileMissingBody": "The download succeeded. The file is what is missing.",
  "@readerFileMissingBody": {
    "description": "⚠️ **Says the DOWNLOAD SUCCEEDED and the FILE is missing.** `architecture.md` § 8 names this divergence. The other phrasing — 'this chapter is unavailable' — would tell the reader the download failed, which is false, and a reader who re-downloads on that sentence is doing the right thing for the wrong reason."
  },
  "readerFileEmptyTitle": "This chapter's recording was interrupted",
  "@readerFileEmptyTitle": {
    "description": "⚠️ **Distinct from 'corrupt'.** Zero bytes is the signature of an INTERRUPTED write, so the sentence is about the recording and the action is a re-download."
  },
  "readerFileEmptyBody": "Nothing was saved, so there is nothing to read.",
  "readerFileCorruptNotMarkdown": "This chapter's saved copy is not readable",
  "@readerFileCorruptNotMarkdown": {
    "description": "B18 / E18 — the file is there and holds no readable prose. The only action is to download it again."
  },
  "readerFileCorruptTruncated": "This chapter's saved copy ends mid-sentence",
  "@readerFileCorruptTruncated": {
    "description": "A truncation mid-character: the final file was still renamed although the write was cut short."
  },
  "readerFileCorruptUnreadableIo": "This chapter's file could not be opened",
  "@readerFileCorruptUnreadableIo": {
    "description": "⚠️ **The action here is RETRY, not re-download.** The copy may be intact and the filesystem merely refused; offering a re-download would suggest the file is at fault when it may not be."
  },
  "readerRowGoneTitle": "This chapter no longer exists in your library",
  "@readerRowGoneTitle": {
    "description": "⚠️ **Not a failure.** A stale identifier is a state of the world — a deep link followed earlier, or a navigation stack restored. It gets its own render and a way back, never an ErrorState, because an ErrorState would report THIS APP as broken for a link the reader followed."
  },
  "readerRowGoneBody": "The link may have been saved before the chapter was removed.",
  "readerLoadFailedTitle": "This chapter could not be opened",
  "@readerLoadFailedTitle": {
    "description": "⚠️ **'Could not be opened', not 'is corrupt'.** This is the absence of a conclusion: the app could not find out which of the other states it is. Saying 'corrupt' would be a guess, and the guess would pick the wrong action."
  },
  "readerLoadFailedBody": "The app does not know whether the file is intact.",
  "readerActionDownloadChapter": "Download this chapter",
  "readerActionDownloadAgain": "Download again",
  "readerActionOpenDownloads": "Open downloads",
  "readerActionBack": "Back",
  "readerActionRetry": "Retry",
  "readerDownloadNeedsConnection": "Downloading needs a connection",
  "@readerDownloadNeedsConnection": {
    "description": "Shown UNDER the disabled primary action (§ 3.5), never as a replacement for it. A disabled button with no reason is a button the reader assumes is broken."
  },
  "readerChapterNumber": "Chapter {number}",
  "@readerChapterNumber": {
    "description": "⚠️ **The placeholder is a `String`, not a number, and that is load-bearing.** `chapters.number` is a `RealColumn` (a `double`), and an ICU `{number}` bound to a double renders \"Chapter 12.0\" — which asserts a decimal place the site never printed. The formatting lives in Dart (`formatChapterNumber`), where a whole value drops its fraction and a fractional one keeps it. Rule 9 is about *displaying* the site's number, and 12.0 is not what the site wrote.",
    "placeholders": {
      "number": {
        "type": "String"
      }
    }
  },
  "readerChapterNumberUnreadable": "Chapter",
  "@readerChapterNumberUnreadable": {
    "description": "The word used when the site's number could not be parsed. Not a number and not an ellipsis: the reader is told the chapter has no number rather than shown a `0`."
  },
  "libraryTitle": "Library",
  "@libraryTitle": {
    "description": "⚠️ **Identical in meaning to `navLibrary`, and separate anyway.** The tab label and the screen title are two surfaces, and the design gives the screen a `--text-h1` title bar. Merging them would make one string serve a 13 dp tab and a 31 dp title."
  },
  "libraryContinueOverline": "CONTINUE READING",
  "@libraryContinueOverline": {
    "description": "An **overline**, 11/16, 600 weight, and it is a LABEL rather than a sentence — the tile under it carries the words."
  },
  "libraryTileUnopened": "{count, plural, =0{No new chapters} =1{1 new chapter} other{{count} new chapters}}",
  "libraryTileAuthorMissing": "Author unknown",
  "@libraryTileAuthorMissing": {
    "description": "⚠️ **A WORD, not a dash.** ADR-024: the author is displayed, never searched, and a site may publish none. An em dash is what a rendering fallback produces; a sentence says the library does not know, which is the actual fact."
  },
  "libraryTileProgress": "{downloaded} of {total} downloaded",
  "@libraryTileProgress": {
    "description": "**The mark's count, not the files'** (B48, ADR-022). An interrupted download has no mark, so this figure never counts a chapter the reader cannot open."
  },
  "libraryTileUndownloaded": "Not downloaded yet",
  "libraryRemoveTitle": "Remove from library?",
  "libraryRemoveBody": "{title} leaves your library. Its {count, plural, =0{no downloaded chapters} =1{1 downloaded chapter} other{{count} downloaded chapters}} and your reading history stay on this phone.",
  "@libraryRemoveBody": {
    "description": "⚠️ **The number appears INSIDE every plural branch, and that is the bug a row caught.** With the count only in the placeholder selector and never in the branches, the sentence renders \"Its downloaded chapters and your reading history stay\" — no figure at all, in a dialog whose whole purpose is to quote one. B32 is a promise about what survives, and \"nothing\" survives it as well as 148 chapters do."
  },
  "libraryRemoveAction": "Remove",
  "libraryRemoveKept": "Nothing was deleted. The chapters are still here.",
  "@libraryRemoveKept": {
    "description": "Shown after a removal, and it says **nothing was deleted**. B32 is a promise the reader should be able to see, not a rule they have to trust."
  },
  "libraryRemoveUndo": "Undo",
  "libraryRemoved": "{title} was removed",
  "librarySimilarTitle": "A novel with this title is already in your library",
  "@librarySimilarTitle": {
    "description": "⚠️ **B40's dialog asks a question the reader can answer, so it names BOTH novels and BOTH sites.** \"Is this the same novel?\" is unanswerable without knowing which site published which."
  },
  "librarySimilarBody": "\"{existing}\" on {source} has the same title as \"{incoming}\" on {incomingSource}.",
  "librarySimilarOpenExisting": "Open the existing one",
  "librarySimilarAddAnyway": "Add anyway",
  "librarySimilarExplain": "Nothing will be merged — they stay two separate novels.",
  "@librarySimilarExplain": {
    "description": "⚠️ **Said BEFORE the choice, not after it.** \"Add anyway\" reads like a merge; this line is what makes it a second row."
  },
  "libraryLoadErrorTitle": "Your library could not be read",
  "libraryAddFailed": "The novel could not be added. It is still listed in Browse.",
  "@libraryAddFailed": {
    "description": "⚠️ **`It is still listed in Browse`**, because B24's submit-error state says the row is still there and nothing is optimistic. A failure that reads as \"gone\" teaches a reader not to trust the screen."
  },
