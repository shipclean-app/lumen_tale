  "causeLayoutChangedTitle": "The pages of this site have changed",
  "@causeLayoutChangedTitle": {
    "description": ""
  },
  "causeLayoutChangedBody": "This is a fault in the copy this app has of {source} — not in {source}, and nothing is to do with how you use it. {retryNote}",
  "@causeLayoutChangedBody": {
    "description": "⚠️ **\"A fault in the copy this app HAS of {source} — not in {source}\".** E8's whole point: the reader did not break anything and the site did not break anything. A message that says \"{source} is broken\" transfers the fault to the site, which is the wrong party and the one the reader cannot report to."
  },
  "causeLayoutChangedRetryNote": "Sometimes it resolves on its own. Rarely.",
  "@causeLayoutChangedRetryNote": {
    "description": "⚠️ **Said BEFORE the button, and it hedges honestly.** A site mid-deployment is a temporary state, and \"sometimes it resolves on its own. Rarely.\" is a sentence that sets the expectation a retry needs to be fair."
  },
  "causeLayoutChangedDictation": "Say: \"the pages of {source} have changed and the app can no longer read them.\"",
  "@causeLayoutChangedDictation": {
    "description": "⚠️ **A sentence the reader can read ALOUD**, which is C12: the reader is often on a phone they cannot type on, and \"the pages of X have changed\" is something a person can act on while \"HTTP 200\" is not."
  },
  "causeSiteUnavailableTitle": "{source} is not answering",
  "@causeSiteUnavailableTitle": {
