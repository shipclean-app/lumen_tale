  "@browseSiteSaidNothingBody": {
    "description": "⚠️ **The query is quoted AND the site is named.** The site's own marker is the reason this state exists at all, and a reader needs to see what they asked for before they decide the site is at fault."
  },
  "browseNoConnectionTitle": "No connection",
  "@browseNoConnectionTitle": {
