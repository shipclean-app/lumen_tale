  "@aboutPrivacyVerify": {
    "description": "The falsifiable form of the privacy claim. A promise that cannot be tested by the reader is marketing; airplane mode is the test, and it takes thirty seconds."
  },
  "@aboutDeliveryBody": {
    "description": "B34 + C3 + C9: the app IS the file. 'There is no app store' is not a limitation to apologise for — it is why there is no account and no server holding anything."
  },
