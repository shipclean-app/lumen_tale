      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX idx_chapters_novel_ordinal ON chapters (novel_id, ordinal)"
        }
      ]
    },
    {
      "name": "idx_chapters_novel_read",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX idx_chapters_novel_read ON chapters (novel_id, is_read)"
        }
      ]
    },
    {
      "name": "idx_history_opened_at",
