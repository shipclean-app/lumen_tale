  "fixed_sql": [
    {
      "name": "novels",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"novels\" (\"id\" TEXT NOT NULL, \"source_id\" TEXT NOT NULL, \"url\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"author\" TEXT NULL, \"description\" TEXT NULL, \"status\" TEXT NOT NULL DEFAULT '', \"cover_url\" TEXT NULL, \"in_library\" INTEGER NOT NULL DEFAULT 0 CHECK (\"in_library\" IN (0, 1)), \"last_checked_at\" INTEGER NULL, \"added_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "chapters",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"chapters\" (\"id\" TEXT NOT NULL, \"novel_id\" TEXT NOT NULL REFERENCES novels (id) ON DELETE CASCADE, \"name\" TEXT NOT NULL, \"number\" REAL NOT NULL DEFAULT -1.0, \"url\" TEXT NOT NULL, \"is_read\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_read\" IN (0, 1)), \"read_at\" INTEGER NULL, \"downloaded_at\" INTEGER NULL, \"ordinal\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "reading_positions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reading_positions\" (\"chapter_id\" TEXT NOT NULL REFERENCES chapters (id) ON DELETE CASCADE, \"offset\" REAL NOT NULL DEFAULT 0.0, \"updated_at\" INTEGER NOT NULL, \"content_height\" INTEGER NULL, PRIMARY KEY (\"chapter_id\"));"
        }
      ]
    },
    {
      "name": "history_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"history_entries\" (\"id\" TEXT NOT NULL, \"novel_id\" TEXT NOT NULL REFERENCES novels (id) ON DELETE RESTRICT, \"chapter_id\" TEXT NOT NULL REFERENCES chapters (id) ON DELETE CASCADE, \"opened_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "queue_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"queue_items\" (\"id\" TEXT NOT NULL, \"chapter_id\" TEXT NOT NULL REFERENCES chapters (id) ON DELETE CASCADE, \"state\" TEXT NOT NULL DEFAULT 'queued', \"queue_position\" INTEGER NOT NULL, \"added_at\" INTEGER NOT NULL, \"started_at\" INTEGER NULL, \"finished_at\" INTEGER NULL, \"attempts\" INTEGER NOT NULL DEFAULT 0, \"error_code\" TEXT NULL DEFAULT '', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "sources",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sources\" (\"id\" TEXT NOT NULL, \"enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"enabled\" IN (0, 1)), \"last_checked_at\" INTEGER NULL, \"last_error_code\" TEXT NULL DEFAULT '', \"settings\" TEXT NOT NULL DEFAULT '{}', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "idx_novels_title",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX idx_novels_title ON novels (title)"
        }
      ]
    },
    {
