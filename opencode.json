{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    ".opencode/rules/*.md"
  ],
  "permission": {
    "bash": {
      "*": "ask",
      "flutter pub get": "allow",
      "flutter pub add *": "allow",
      "flutter pub remove *": "allow",
      "flutter analyze": "allow",
      "flutter analyze *": "allow",
      "flutter test": "allow",
      "flutter test *": "allow",
      "dart format *": "allow",
      "dart run build_runner *": "allow",
      "git status": "allow",
      "git diff *": "allow",
      "git log *": "allow"
    }
  }
}
