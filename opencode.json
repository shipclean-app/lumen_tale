{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    ".opencode/rules/*.md"
  ],
  "permission": {
    "bash": {
      "allow": [
        "flutter pub get",
        "flutter pub add *",
        "flutter pub remove *",
        "flutter analyze",
        "flutter test",
        "flutter gen-l10n",
        "flutter doctor",
        "flutter --version",
        "dart format .",
        "dart run build_runner build *",
        "dart run drift_dev *",
        "git status",
        "git diff *",
        "git log *",
        "git add *",
        "git commit *",
        "git branch *",
        "git checkout *",
        "git show *"
      ]
    }
  }
}